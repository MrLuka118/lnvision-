# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Product name shown everywhere in the UI and in e-mails.
APP_NAME=Aperture Studio

DATABASE_URL=postgres://aperture:aperture@db:5432/aperture
REDIS_URL=redis://redis:6379/0

# Dev: Mailpit catches all mail (UI on http://localhost:8025).
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Aperture Studio <studio@localhost>

# Set to false to close public sign-ups.
ACCOUNT_ALLOW_SIGNUPS=true

# Google sign-in (optional). Create an OAuth client in Google Cloud Console,
# redirect URI: http://localhost:8000/racun/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production only: S3-compatible storage (Cloudflare R2 / Backblaze B2).
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=aperture-private
# S3_PUBLIC_BUCKET=aperture-renditions
# S3_PUBLIC_DOMAIN=img.example.com
SITE_URL=http://localhost:8000

# Use built Vite assets by default; opt into the local Vite development server explicitly.
VITE_DEV_MODE=False
