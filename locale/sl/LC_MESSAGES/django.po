#: templates/core/styleguide.html:3 templates/core/styleguide.html:5
msgid "Design system"
msgstr "Oblikovni sistem"

#: templates/core/styleguide.html:5
msgid ""
"The interface stays neutral grey so it never shifts how the colours in a "
"photograph are perceived. Colour comes from the photographs."
msgstr ""
"Vmesnik ostaja nevtralno siv, da nikoli ne vpliva na zaznavanje barv na "
"fotografiji. Barve prihajajo iz fotografij."

#: templates/core/styleguide.html:11
msgid "Colour"
